# Greenvale Business Map — environment template.
# Copy to .env for local development (never commit .env). In Claude Code on the web, set these in the
# cloud environment's settings instead. In Cloud Run, use --set-env-vars / --set-secrets.

# ---------- Google credentials ----------
# Browser key for Maps JavaScript API. It is sent to the browser by design, so restrict it:
#   Application restrictions: Websites → http://localhost:8080/*, http://127.0.0.1:8080/*, https://YOUR-APP-URL/*
#   API restrictions: Maps JavaScript API only
GOOGLE_MAPS_BROWSER_KEY=AIzaSy_REPLACE_WITH_BROWSER_KEY

# Server key for Places API (New) + Places Aggregate API. Server-side only: never put it in public/.
#   Application restrictions: none (or IP addresses if your server has a fixed egress IP)
#   API restrictions: Places API (New), Places Aggregate API
GOOGLE_PLACES_SERVER_KEY=AIzaSy_REPLACE_WITH_SERVER_KEY

# Map ID (Google Cloud Console → Google Maps Platform → Map management, type JavaScript).
# DEMO_MAP_ID is used when unset, which is fine for development only.
GOOGLE_MAPS_MAP_ID=

# key  = send GOOGLE_PLACES_SERVER_KEY in X-Goog-Api-Key (default)
# proxy = send no key; a network-secret proxy (e.g. Claude Code's) injects the credential for
#         places.googleapis.com and areainsights.googleapis.com. Development only.
PLACES_AUTH_MODE=key

# Development convenience: if no server key is set, use the browser key for Places calls.
# Only works while the browser key has no website restriction. Defaults to true in development,
# always false when NODE_ENV=production.
PLACES_ALLOW_BROWSER_KEY_FALLBACK=true

# ---------- Server ----------
NODE_ENV=development
PORT=8080
# Defaults to 127.0.0.1 (private). Listening elsewhere requires APP_ACCESS_PASSWORD or TRUST_UPSTREAM_AUTH.
HOST=127.0.0.1
# HTTP Basic auth password for everyone (any username). Leave empty when IAP/IAM protects the service.
APP_ACCESS_PASSWORD=
# Set true only when Identity-Aware Proxy (or similar) already restricts access.
TRUST_UPSTREAM_AUTH=false

# ---------- Storage (place IDs, Google's electorate verdicts, reviews, usage counters) ----------
# file      = JSON file in DATA_DIR (local machine; not durable in ephemeral containers)
# firestore = Cloud Firestore (recommended for deployment; uses Application Default Credentials)
# memory    = tests only
STORAGE_BACKEND=file
DATA_DIR=./.data
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=gbm_
# Only where Application Default Credentials are unavailable (e.g. Claude Code cloud sessions):
# the full JSON of a service-account key that has only the "Cloud Datastore User" role.
FIRESTORE_CREDENTIALS_JSON=

# ---------- Cost controls (self-imposed, per UTC day) ----------
DAILY_TEXT_SEARCH_LIMIT=300
DAILY_DETAILS_LIMIT=150
DAILY_GAP_FILL_LIMIT=500
DAILY_AGGREGATE_LIMIT=150
SWEEP_MAX_TEXT_SEARCH=120
SWEEP_MAX_AGGREGATE=40
GAP_FILL_MAX=100
AREA_SEARCH_MAX_KM=20
# Google's inside/outside verdicts are re-checked after this many days.
MEMBERSHIP_MAX_AGE_DAYS=30
PLACES_CONCURRENCY=2
PLACES_TIMEOUT_MS=20000
